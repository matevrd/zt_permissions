{
  "name": "matevrd/zt_permissions",
  "type": "typo3-cms-extension",
  "description": "Least-Privilege Audit Modul und Multi-Site Zugriffskontrolle Zero-Trust-Erweiterung",
  "license": "GPL-2.0-or-later",
  "require": {
    "typo3/cms-core": "^14.3",
    "typo3/cms-scheduler": "^14.3"
  },
  "autoload": {
    "psr-4": {
      "matevrd\\ZtPermissions\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "matevrd\\ZtPermissions\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "zt_permissions"
    }
  }
}
